# Banco de Dados (MySQL / MariaDB)
DATABASE_URL="mysql://root:senha@127.0.0.1:3306/agendapsi"

# Segurança e Autenticação
JWT_SECRET="gere_um_segredo_jwt_aleatorio_e_seguro_com_pelo_menos_32_caracteres"
# Chave dedicada para criptografia AES-256-GCM de credenciais de integrações em repouso (opcional; usa JWT_SECRET como fallback)
# PSI_ENCRYPTION_KEY=""
TECHNICAL_STATUS_BEARER_TOKEN="gere_um_token_bearer_de_alta_entropia_para_monitoramento_tecnico"
# Segredo para validar webhooks externos genéricos ou TextBee Self-Hosted (X-PSI-Webhook-Secret)
# MESSAGE_WEBHOOK_SECRET=""
# Monitoramento Técnico Local (Opcional - Estritamente para desenvolvimento em loopback)
# PSI_LOCAL_TECHNICAL_STATUS_PUBLIC="false" # Defina como "true" em .env.local para testar o endpoint sem autenticação em http://localhost:3000/api/technical/status

# Configurações do Sistema
NODE_ENV="development"
APP_URL="http://localhost:3000"
APP_TIMEZONE="America/Sao_Paulo"

# Armazenamento Privado (fora do diretório público)
STORAGE_DIR="./storage/uploads"
BACKUP_DIR="./storage/backups"

# Teleconsulta (V1 Jitsi)
JITSI_DOMAIN="meet.jit.si"

# E-mail Padrão do Servidor PSI (usado quando Admin -> Integrações -> E-mail está no modo E-mail Padrão)
# PSI_DEFAULT_SMTP_HOST=""
# PSI_DEFAULT_SMTP_PORT="587"
# PSI_DEFAULT_SMTP_ENCRYPTION="TLS"
# PSI_DEFAULT_SMTP_USER=""
# PSI_DEFAULT_SMTP_PASS=""
# PSI_DEFAULT_SMTP_FROM="noreply@consultorio.psi.br"
# PSI_DEFAULT_SMTP_SENDER_NAME="Consultório PSI"
# PSI_DEFAULT_SMTP_REPLY_TO=""

# Aliases legados de SMTP (mantidos apenas por compatibilidade reversa)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@consultorio.psi.br"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
